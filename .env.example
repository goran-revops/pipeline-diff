# Copy to .env and fill in. Git ignores .env.

# HubSpot: a private app token or a Service Key (read scopes: crm.objects.deals.read, crm.objects.owners.read)
PIPELINE_DIFF_HUBSPOT_TOKEN=

# Salesforce: an External Client App with the client credentials flow
PIPELINE_DIFF_SF_DOMAIN=yourorg-dev-ed.develop.my
PIPELINE_DIFF_SF_CONSUMER_KEY=
PIPELINE_DIFF_SF_CONSUMER_SECRET=

# Optional
PIPELINE_DIFF_DATA_DIR=./data
PIPELINE_DIFF_TIMEZONE=UTC
